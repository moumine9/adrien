{
  "name": "adrien-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "pretest": "pnpm build",
    "test": "vitest run",
    "lint": "biome check . && pnpm lint:md",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "markdownlint-cli2": "^0.24.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
