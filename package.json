{
  "name": "adrien-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:site": "node scripts/build-site.mjs",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "lint": "biome check . && pnpm lint:md",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "lint:md": "markdownlint-cli2",
    "changelog": "node scripts/changelog.mjs",
    "changelog:check": "node scripts/check-changelog.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "markdown-it": "^15.0.3",
    "markdownlint-cli2": "^0.24.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
